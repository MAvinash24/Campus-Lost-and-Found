<mxfile host="app.diagrams.net"><diagram name="ER model  Keys relationships and cardinalities"><mxGraphModel dx="2200" dy="1500" grid="1" page="1" pageWidth="2200" pageHeight="1500"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="users" value="USERS&#10;PK id&#10;name | UNIQUE email&#10;password_hash | role&#10;created_at" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="75" y="180" width="520" height="400" /></mxCell><mxCell id="reports" value="REPORTS&#10;PK id&#10;FK reporter_id → users.id&#10;FK moderator_id → users.id (nullable)&#10;kind | title | description | category&#10;location | item_date | status&#10;moderation | moderation_reason&#10;created_at | recovered_at" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=30;" vertex="1" parent="1"><mxGeometry as="geometry" x="825" y="180" width="620" height="560" /></mxCell><mxCell id="messages" value="MESSAGES&#10;PK id&#10;FK report_id → reports.id&#10;FK sender_id → users.id&#10;FK recipient_id → users.id&#10;body | created_at" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=29;" vertex="1" parent="1"><mxGeometry as="geometry" x="1680" y="180" width="450" height="480" /></mxCell><mxCell id="audits" value="AUDIT_EVENTS&#10;PK id | FK actor_id → users.id (nullable)&#10;event | object_id | outcome | created_at&#10;object_id is a logical reference" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=29;" vertex="1" parent="1"><mxGeometry as="geometry" x="75" y="900" width="640" height="310" /></mxCell><mxCell id="attempts" value="LOGIN_ATTEMPTS&#10;PK id | email | source (keyed hash) | created_at&#10;No user FK: includes unknown login identifiers" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontC