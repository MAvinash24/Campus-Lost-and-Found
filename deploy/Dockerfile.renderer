FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-writer python3 python3-venv poppler-utils fonts-liberation && python3 -m venv /opt/render && /opt/render/bin/pip install pdf2image==1.17.0 Pillow==12.0.0 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
