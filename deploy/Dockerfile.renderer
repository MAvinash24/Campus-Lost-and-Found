FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-writer python3 python3-venv poppler-utils fonts-liberation \
    && python3 -m venv /opt/render \
    && /opt/render/bin/pip install pdf2image==1.17.0 Pillow==12.0.0 \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/home/renderer
RUN groupadd --gid 10001 renderer \
    && useradd --uid 10001 --gid 10001 --create-home renderer \
    && mkdir -p /work && chown renderer:renderer /work
WORKDIR /work
USER 10001:10001
